# кодування документів
AddDefaultCharset utf-8
#AddDefaultCharset koi8-u
#AddDefaultCharset windows-1251

# індексні файли та приховані розширення
DirectoryIndex iNdex.php index.php index.xhtml index.html index.htm
IndexIgnore *.bak *.i* *.htaccess *.log *.xml HTTP*.* *.tmp *.css *.shtml *Коп*.*

# часовий пояс оточення
#SetEnv TZ "Europe/Kiev"
SetEnv TZ "Europe/Kyiv"

#<IfModule mod_php.c>
<IfModule php_module>
	# дефолтний часовий пояс: Європа/Київ
	#php_value date.timezone 'Europe/Kiev'
	php_value date.timezone 'Europe/Kyiv'
	# вимикаємо відображення помилок
	php_flag display_errors off
	# валідний для xhtml роздільник
	php_value arg_separator.output &amp;
	# вимкнути обмеження "життя" cookies (очікує число секунд, а не off у PHP 8)
	#php_flag session.cookie_lifetime off
	# вмикаємо(?) вбудоване стиснення
	#php_flag zlib.output_compression on
	# кодування за замовчуванням
	php_value default_charset UTF-8
</IfModule>

# лістинг директорій та симлінки
Options -Indexes
Options +FollowSymLinks

<IfModule mod_autoindex.c>
	IndexOptions Charset=UTF-8 FancyIndexing FoldersFirst HTMLtable IgnoreCase NameWidth=* DescriptionWidth=* XHTML
	IndexOrderDefault Ascending Name
	AddDescription "txt file" .txt
	AddDescription "rtf file" .rtf
	AddDescription "xls file" .xls .xlsx
	AddDescription "doc file" .doc .docx
	AddDescription "iso file" .iso
	AddDescription "bin file" .bin
	AddDescription "pdf file" .pdf
	AddDescription "rar file" .rar
	AddDescription "zip file" .zip
	AddDescription "7z file" .7z
	AddDescription "img file" .img
	AddDescription "mid file" .mid
	AddDescription "wav file" .wav
	AddDescription "mp3 file" .mp3
	AddDescription "ogg file" .ogg
	AddDescription "avi file" .avi
	AddDescription "mp4 file" .mp4
	AddDescription "mov file" .mov
	AddDescription "jpg file" .jpg .jpeg
	AddDescription "png file" .png
	AddDescription "webp file" .webp
	AddDescription "gif file" .gif
	AddDescription "exe file" .exe
	AddDescription "apk file" .apk
</IfModule>

# закриваємо прямий доступ до прихованих файлів (.htaccess, .git, .env тощо)
<FilesMatch "^\.">
	Require all denied
</FilesMatch>

# закриваємо прямий доступ до файлів баз даних і тимчасових файлів
<FilesMatch "\.(sqlite|sqlite3|db|tmp)$">
	Require all denied
</FilesMatch>

# перевизначаємо сторінки помилок:
ErrorDocument 401 /pages/HTTP_st.php?code=401
ErrorDocument 402 /pages/HTTP_st.php?code=402
ErrorDocument 403 /pages/HTTP_st.php?code=403
ErrorDocument 404 /pages/HTTP_st.php?code=404
ErrorDocument 405 /pages/HTTP_st.php?code=405
ErrorDocument 406 /pages/HTTP_st.php?code=406
ErrorDocument 407 /pages/HTTP_st.php?code=407
ErrorDocument 409 /pages/HTTP_st.php?code=409
ErrorDocument 410 /pages/HTTP_st.php?code=410
ErrorDocument 411 /pages/HTTP_st.php?code=411
ErrorDocument 412 /pages/HTTP_st.php?code=412
ErrorDocument 415 /pages/HTTP_st.php?code=415
ErrorDocument 416 /pages/HTTP_st.php?code=416
ErrorDocument 417 /pages/HTTP_st.php?code=417
ErrorDocument 421 /pages/HTTP_st.php?code=421
ErrorDocument 422 /pages/HTTP_st.php?code=422
ErrorDocument 423 /pages/HTTP_st.php?code=423
ErrorDocument 424 /pages/HTTP_st.php?code=424
ErrorDocument 426 /pages/HTTP_st.php?code=426
ErrorDocument 428 /pages/HTTP_st.php?code=428
ErrorDocument 429 /pages/HTTP_st.php?code=429
ErrorDocument 451 /pages/HTTP_st.php?code=451
ErrorDocument 501 /pages/HTTP_st.php?code=501
ErrorDocument 505 /pages/HTTP_st.php?code=505
ErrorDocument 506 /pages/HTTP_st.php?code=506
ErrorDocument 507 /pages/HTTP_st.php?code=507
ErrorDocument 508 /pages/HTTP_st.php?code=508
ErrorDocument 510 /pages/HTTP_st.php?code=510
ErrorDocument 511 /pages/HTTP_st.php?code=511

# статичні HTML для реальних сценаріїв, коли PHP не може відпрацювати
ErrorDocument 400 /pages/HTTP400.html
ErrorDocument 408 /pages/HTTP408.html
ErrorDocument 413 /pages/HTTP413.html
ErrorDocument 414 /pages/HTTP414.html
ErrorDocument 431 /pages/HTTP431.html
ErrorDocument 500 /pages/HTTP500.html
ErrorDocument 502 /pages/HTTP502.html
ErrorDocument 503 /pages/HTTP503.html
ErrorDocument 504 /pages/HTTP504.html

<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteRule ^HTTP_status\.php$ /pages/HTTP_st.php [L,QSA]
	# пошук кореневих файлів у теці /pages/
	RewriteBase /
	RewriteCond %{SCRIPT_FILENAME} !-f
	RewriteRule ^([^/]+)$ pages/$1 [L,QSA]
</IfModule>

